rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProfile entity
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Validation helper for Generation entity
    function isValidGeneration(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'toolName', 'prompt', 'result', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.toolName is string && data.toolName.size() > 0 && data.toolName.size() <= 128
        && data.prompt is string && data.prompt.size() <= 10000
        && data.result is string && data.result.size() <= 50000
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Health/Connection Verification Route
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == userId
        && incoming().userId == request.auth.uid;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User AI Generated Content & History Subcollection
      match /generations/{generationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(generationId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(generationId)
          && isValidGeneration(incoming(), userId)
          && incoming().id == generationId;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(generationId)
          && isValidGeneration(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'result', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(generationId);
      }
    }
  }
}
